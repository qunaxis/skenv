{
  "$schema": "https://qunaxis.github.io/skenv/schemas/skenv.schema.json",
  "user": {
    "dependencies": {
      "archify": {
        "repo": "ext/tools",
        "skill_dir": "tools/archify",
        "commit": "<new-rev>"
      },
      "other": {
        "repo": "ext/tools",
        "skill_dir": "tools/other",
        "commit": "<rev>"
      }
    },
    "checkouts": {
      "skills": {
        "repo": "me/skills",
        "checkout_dir": "~/src/skills"
      }
    },
    "unmanaged": [
      "tool<x>&*"
    ]
  }
}
