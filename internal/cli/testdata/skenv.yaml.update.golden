# yaml-language-server: $schema=https://qunaxis.github.io/skenv/schemas/skenv.schema.json
# my manifest
user:
  # where skills live
  checkouts:
    skills:
      repo: me/skills   # the manifest repository
      checkout_dir: ~/src/skills

  # pinned third-party skills
  dependencies:
    archify:
      repo: ext/tools
      skill_dir: tools/archify
      commit: "<new-rev>"   # keep this comment
    other:
      repo: ext/tools
      skill_dir: tools/other
      commit: <rev>
  machines:
    other-host:
      exclude: [beta]
