{
  "$comment": "managed by skenv [[ .Harness ]] — do not edit; personal settings go to .claude/settings.local.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v skenv >/dev/null 2>&1 || exit 0; skenv lint --hook"
          }
        ]
      }
    ]
  }
}
